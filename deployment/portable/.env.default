DATABASE_HOST=xyne-db
VESPA_HOST=vespa
OCR_PROVIDERS=
PDF_PROCESSING_DISABLE_FALLBACKS=false
DOCKER_UID=1000
DOCKER_GID=1000
XYNE_DATA_DIR=./data
HOST=http://localhost:3000
KEYCLOAK_PORT=8082
EMBEDDING_MODEL="bge-small-en-v1.5"
DATABASE_URL=postgresql://xyne:xyne@${DATABASE_HOST}:5432/xyne
POSTGRES_PASSWORD=
REASONING="true"
METRICS_PORT=3001
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/callback
GOOGLE_PROD_REDIRECT_URI=http://localhost:3000/v1/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WEB_LOGIN_ENABLED=true
KEYCLOAK_WEB_ENABLED=false
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0
KEYCLOAK_PUBLIC_BASE_URL=http://localhost:3000/keycloak
KEYCLOAK_INTERNAL_BASE_URL=http://keycloak:8080/keycloak
KEYCLOAK_REALM=xyne-shared
KEYCLOAK_CLIENT_ID=xyne-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_WORKSPACE_EXTERNAL_ID=xyne-shared-workspace
KEYCLOAK_LOGOUT_REDIRECT_URL=/auth
KC_DB_USERNAME=
KC_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
XYNE_BOOTSTRAP_ADMIN_EMAIL=admin@xyne.local
XYNE_BOOTSTRAP_ADMIN_NAME="Xyne Admin"
XYNE_BOOTSTRAP_ADMIN_PASSWORD=
XYNE_BOOTSTRAP_WORKSPACE_NAME="Xyne Shared"
XYNE_BOOTSTRAP_WORKSPACE_DOMAIN=xyne.local
KEYCLOAK_BOOTSTRAP_RESET_ADMIN_PASSWORD=false
ENCRYPTION_KEY=
JWT_SECRET=
SERVICE_ACCOUNT_ENCRYPTION_KEY=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
NODE_ENV=
USER_SECRET=

# LiteLLM model catalog override.
# Set this when mounting a local model catalog into app/app-sync.
# LITELLM_MODEL_CONFIG_PATH=/usr/src/app/server/config/litellm-models.json
# MODELS_LIST=your-model-id
# LITELLM_BEST_AGENTIC_MODEL=your-model-id
# LITELLM_FAST_MODEL=your-model-id
# LITELLM_BEST_MODEL=your-model-id
# LITELLM_DEEP_RESEARCH_MODEL=your-model-id
# LITELLM_WEB_SEARCH_MODEL=your-model-id
# LITELLM_SQL_INFERENCE_MODEL=your-model-id
# TOC_LLM_MODEL=your-model-id

# NGINX Configuration
NGINX_DOMAIN=localhost

# LiveKit Configuration  
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_URL=ws://${NGINX_DOMAIN}/rtc
LIVEKIT_CLIENT_URL=http://${NGINX_DOMAIN}

# Sync Server Configuration
SYNC_SERVER_HOST=app-sync
MAIN_SERVER_HOST=app

# Async Docling / Redis ingestion
REDIS_URL=redis://redis:6379/0
DOCLING_PAGE_CHUNK_SIZE=50
DOCLING_STREAMING_MIN_PAGES=51
DOCLING_ASYNC_ENABLED=true
DOCLING_ASYNC_SCHEDULER_ENABLED=false
KB_STORAGE_ROOT=storage/kb_files
DOCLING_ASYNC_STORAGE_ROOT=storage/doclingAsync
DOCLING_RESULTS_STREAM=docling:results
DOCLING_RESULT_GROUP=app-sync
DOCLING_SCHEDULER_RESULT_GROUP=app-sync-scheduler
DOCLING_SCHEDULER_POLL_MS=1000
DOCLING_SCHEDULER_LEASE_MS=600000
DOCLING_SCHEDULER_SPLIT_CONCURRENCY=1
DOCLING_SCHEDULER_ACTIVE_OCR_FILES=4
DOCLING_SCHEDULER_PER_FILE_INFLIGHT_PARTS=2
DOCLING_SCHEDULER_MAX_PART_ATTEMPTS=3
DOCLING_SCHEDULER_MAX_WRITE_ATTEMPTS=5
DOCLING_SCHEDULER_RETRY_BASE_MS=30000
DOCLING_SCHEDULER_RETRY_MAX_MS=600000
DOCLING_SCHEDULER_VESPA_WRITE_PERMITS=1
DOCLING_SCHEDULER_VESPA_WRITE_PERMIT_TTL_MS=1800000
DOCLING_SCHEDULER_VESPA_WRITE_TIMEOUT_MS=300000
DOCLING_SCHEDULER_MAX_VESPA_PAYLOAD_BYTES=9437184
DOCLING_ASYNC_PART_SUBMIT_CONCURRENCY=2
DOCLING_ASYNC_SUBMIT_PERMITS_ENABLED=false
DOCLING_ASYNC_SUBMIT_PERMITS=16
DOCLING_ASYNC_SUBMIT_PERMIT_LEASE_TTL_MS=21600000
DOCLING_ASYNC_SUBMIT_PERMIT_POLL_MS=180000
DOCLING_ASYNC_SUBMIT_PERMIT_MAX_WAIT_MS=0
DOCLING_RESULT_CONCURRENCY=2
DOCLING_RESULT_READ_COUNT=2
DOCLING_RESULT_MIN_IDLE_MS=600000
PDF_FILE_PROCESSING_WORKER_THREADS=8
APP_SYNC_PDF_LIB_CONCURRENCY=2
APP_SYNC_PDF_LIB_SEMAPHORE_TIMEOUT_MS=600000
APP_SYNC_DIAGNOSTICS_ENABLED=true
APP_SYNC_DIAGNOSTICS_DIR=/usr/src/app/server/logs/app-sync-diagnostics
APP_SYNC_RESOURCE_SAMPLE_INTERVAL_MS=2000
