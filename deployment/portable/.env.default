DATABASE_HOST=xyne-db
VESPA_HOST=vespa
DOCKER_UID=1000
DOCKER_GID=1000
XYNE_DATA_DIR=./data
HOST=http://localhost:3000
KEYCLOAK_PORT=8082
EMBEDDING_MODEL="bge-small-en-v1.5"
DATABASE_URL=postgresql://xyne:xyne@${DATABASE_HOST}:5432/xyne
POSTGRES_PASSWORD=
REASONING="true"
METRICS_PORT=3001
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/callback
GOOGLE_PROD_REDIRECT_URI=http://localhost:3000/v1/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WEB_LOGIN_ENABLED=true
KEYCLOAK_WEB_ENABLED=false
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0
KEYCLOAK_PUBLIC_BASE_URL=http://localhost:3000/keycloak
KEYCLOAK_INTERNAL_BASE_URL=http://keycloak:8080/keycloak
KEYCLOAK_REALM=xyne-shared
KEYCLOAK_CLIENT_ID=xyne-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_WORKSPACE_EXTERNAL_ID=xyne-shared-workspace
KEYCLOAK_LOGOUT_REDIRECT_URL=/auth
KC_DB_USERNAME=
KC_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
XYNE_BOOTSTRAP_ADMIN_EMAIL=admin@xyne.local
XYNE_BOOTSTRAP_ADMIN_NAME="Xyne Admin"
XYNE_BOOTSTRAP_ADMIN_PASSWORD=
XYNE_BOOTSTRAP_WORKSPACE_NAME="Xyne Shared"
XYNE_BOOTSTRAP_WORKSPACE_DOMAIN=xyne.local
KEYCLOAK_BOOTSTRAP_RESET_ADMIN_PASSWORD=false
ENCRYPTION_KEY=
JWT_SECRET=
SERVICE_ACCOUNT_ENCRYPTION_KEY=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
NODE_ENV=
USER_SECRET=

# LiteLLM model catalog override.
# Set this when mounting a local model catalog into app/app-sync.
# LITELLM_MODEL_CONFIG_PATH=/usr/src/app/server/config/litellm-models.json
# MODELS_LIST=your-model-id
# LITELLM_BEST_AGENTIC_MODEL=your-model-id
# LITELLM_FAST_MODEL=your-model-id
# LITELLM_BEST_MODEL=your-model-id
# LITELLM_DEEP_RESEARCH_MODEL=your-model-id
# LITELLM_WEB_SEARCH_MODEL=your-model-id
# LITELLM_SQL_INFERENCE_MODEL=your-model-id
# TOC_LLM_MODEL=your-model-id

# NGINX Configuration
NGINX_DOMAIN=localhost

# LiveKit Configuration  
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_URL=ws://${NGINX_DOMAIN}/rtc
LIVEKIT_CLIENT_URL=http://${NGINX_DOMAIN}

# Sync Server Configuration
SYNC_SERVER_HOST=app-sync
MAIN_SERVER_HOST=app
